generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal
  createdAt   DateTime @default(now())
}

model Collection {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  heroSlides HeroSlide[]

  @@map("collection")
}

model HeroSlide {
  id           String     @id @default(cuid())
  collectionId String
  type         MediaType  @default(IMAGE)
  url          String
  publicId     String     @unique
  alt          String     @default("")
  width        Int?
  height       Int?
  format       String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, order])
  @@map("hero_slides")
}

enum MediaType {
  IMAGE
  VIDEO
}
